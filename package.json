{
  "name": "albushra-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply albushra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply albushra-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}

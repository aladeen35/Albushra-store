{
  "name": "albushra-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply albushra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply albushra-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vendor:three": "esbuild scripts/three-entry.js --bundle --minify --format=esm --outfile=public/vendor/three.min.js",
    "dev:ai": "wrangler dev",
    "vendor:motion": "esbuild scripts/motion-entry.js --bundle --minify --format=esm --outfile=public/vendor/motion.min.js"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
